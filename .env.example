# Server/dev only. Never commit a real key.
WORLDNEWSAPI_KEY=

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_SITE_URL=https://cssguardianangel.com

# Stripe (server-side only — set in Vercel + .env.local for local dev)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: recurring PKR 500/month Price ID from Stripe Dashboard.
# If omitted, checkout creates the monthly price automatically.
STRIPE_PRICE_ID_MONTHLY=

# Voucher code for free premium access (server-side only). Leave empty to disable vouchers.
PREMIUM_VOUCHER_CODE=

# Supabase service role — required for Stripe webhooks to update subscriptions.
# Never expose this in frontend code or VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=
